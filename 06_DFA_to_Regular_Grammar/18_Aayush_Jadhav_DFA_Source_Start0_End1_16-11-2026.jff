<?xml version="1.0" encoding="UTF-8"?>
<structure>
  <type>fa</type>
  <automaton>
    <state id="0" name="q0">
      <x>100</x>
      <y>170</y>
      <label>Start</label>
      <initial/>
    </state>
    <state id="1" name="q1">
      <x>300</x>
      <y>250</y>
      <label>Started 0; ends 0</label>
    </state>
    <state id="2" name="q2">
      <x>500</x>
      <y>170</y>
      <label>Started 0; ends 1</label>
      <final/>
    </state>
    <state id="3" name="qd">
      <x>300</x>
      <y>70</y>
      <label>Dead state</label>
    </state>
    <transition>
      <from>0</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>0</from>
      <to>3</to>
      <read>1</read>
    </transition>
    <transition>
      <from>1</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>1</from>
      <to>2</to>
      <read>1</read>
    </transition>
    <transition>
      <from>2</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>2</from>
      <to>2</to>
      <read>1</read>
    </transition>
    <transition>
      <from>3</from>
      <to>3</to>
      <read>0</read>
    </transition>
    <transition>
      <from>3</from>
      <to>3</to>
      <read>1</read>
    </transition>
  </automaton>
</structure>
